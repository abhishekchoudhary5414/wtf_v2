{
  "name": "wtf-university-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "start:frontend": "npm run start --prefix frontend",
    "lint:frontend": "npm run lint --prefix frontend",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --port 8000",
    "flyway:migrate": "cd backend && python3 run_flyway.py",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}

